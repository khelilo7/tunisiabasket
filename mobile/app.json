{
  "expo": {
    "name": "Tunisia Basket",
    "slug": "tunisia-basket",
    "scheme": "tunisiabasket",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1020",
    "ios": {
      "bundleIdentifier": "com.tunisiabasket.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.tunisiabasket.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B1020"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BarlowCondensed-ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed-SemiBold.ttf"
          ]
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#FF8A1F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cd9c0c1c-6089-4cf8-b4e6-7dfc75acfb72"
      }
    },
    "owner": "tunisiabasket"
  }
}
